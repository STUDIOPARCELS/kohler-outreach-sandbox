# --- Supabase (required) ---
# KOHLER_* names take precedence over the standard names (see src/lib/supabaseAdmin.ts);
# they exist so a Vercel Supabase integration can't silently override the values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# KOHLER_SUPABASE_URL=https://your-project.supabase.co
# KOHLER_SUPABASE_KEY=your-service-role-key

# --- Route auth secrets ---
CRON_SECRET=change-me            # Vercel cron auth (/api/cron/research; also accepted by /api/ingest/careers)
INGEST_SECRET=change-me          # /api/ingest/ziprecruiter and /api/ingest/careers (x-import-secret / Bearer)
IMPORT_SECRET=change-me          # /api/import-ziprecruiter; fallback secret for the ingest routes
API_SECRET=change-me             # requireApiSecret routes (e.g. /api/gmail/backfill-responses)

# --- Safety gates (default off; set to the string "true" to enable) ---
ENABLE_LIVE_SEND=false           # allow live Gmail SMTP sends (/api/send-email, /api/approve-followup)
ENABLE_CONTACT_ENRICHMENT=false  # allow the research cron to call RocketReach automatically
ENABLE_GOVERNMENT_JOB_SOURCES=false  # poll GovernmentJobs/USAJOBS aggregates in careers ingest

# --- Google OAuth + Gmail ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://your-deployment.vercel.app/api/google/callback  # defaults to the production callback when unset
GMAIL_USER=you@gmail.com         # Gmail account used for SMTP sends
GMAIL_APP_PASSWORD=your-gmail-app-password
REPLY_TO_EMAIL=you@example.com   # Reply-To header on outbound email (has an in-code default)
GOOGLE_PLACES_API_KEY=your-places-key  # /api/search-places, /api/backfill-addresses, /api/find-leads

# --- External providers / AI ---
ROCKETREACH_API_KEY=your-rocketreach-key  # contact discovery and email lookup routes
OPENAI_API_KEY=your-openai-key            # company descriptions, contact research, careers-url backfill, job search
ANTHROPIC_API_KEY=your-anthropic-key      # /api/match-skills
USAJOBS_AUTHORIZATION_KEY=your-usajobs-api-key  # USAJOBS search (USAJOBS_API_KEY also accepted)
USAJOBS_USER_AGENT=your-email@example.com       # required by USAJOBS API (USAJOBS_EMAIL also accepted)

# --- Runtime identity / diagnostics (optional) ---
NEXT_PUBLIC_APP_ENV=sandbox      # explicit sandbox/production badge (APP_ENV and KOHLER_DEPLOY_TARGET also read)
# NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app  # site-URL hint for runtime diagnostics
# JOB_PARSER_VERSION=5           # override the reported job parser version

# Note: VERCEL_ENV, VERCEL_URL, VERCEL_PROJECT_NAME, and NODE_ENV are read by the
# code but provided automatically by Vercel/Next.js — do not set them by hand.
